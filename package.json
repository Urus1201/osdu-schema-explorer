{
  "name": "osdu-schema-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first evidence-backed OSDU schema graph explorer",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "schemas",
    "scripts",
    "docs/architecture.md",
    "docs/data-format.md",
    "docs/dependency-licenses.json",
    "docs/privacy.md",
    "docs/recovery.md",
    "docs/sources.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx src/server/main.ts",
    "graph": "tsx src/cli/main.ts",
    "init": "tsx src/cli/main.ts init",
    "build": "tsc --noEmit && vite build && tsx scripts/build-notices.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "tsx scripts/licenses.ts --write",
    "licenses:check": "tsx scripts/licenses.ts",
    "release:check": "tsx scripts/release-check.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run licenses:check && npm run release:check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "1.29.2",
    "react-force-graph-3d": "1.29.2",
    "three": "0.186.1",
    "three-spritetext": "1.10.0"
  },
  "overrides": {
    "rollup": "4.62.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
