{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osdu-schema-explorer.local/schemas/patch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "nodes", "edges", "evidence"],
  "properties": {
    "formatVersion": { "const": 1 },
    "nodes": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/definitions/edge" } },
    "evidence": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/definitions/evidence" }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "hash": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "namespace",
        "kind",
        "version",
        "domain",
        "schemaHash",
        "evidenceIds"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "type": { "enum": ["entity", "property", "fragment", "reference_data"] },
        "label": { "$ref": "#/definitions/text" },
        "namespace": { "$ref": "#/definitions/text" },
        "kind": { "$ref": "#/definitions/text" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "domain": { "$ref": "#/definitions/text" },
        "schemaHash": { "$ref": "#/definitions/hash" },
        "evidenceIds": { "$ref": "#/definitions/ids" },
        "description": { "type": "string", "maxLength": 8192 },
        "ownerId": { "$ref": "#/definitions/text" },
        "propertyPath": { "$ref": "#/definitions/text" },
        "occurrencePath": { "type": "string", "pattern": "^/", "maxLength": 4096 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "type",
        "direction",
        "fieldPath",
        "branch",
        "evidenceCategory",
        "evidenceIds"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "source": { "$ref": "#/definitions/text" },
        "target": { "$ref": "#/definitions/text" },
        "type": {
          "enum": [
            "references_record",
            "contains_property",
            "composes_schema",
            "documented_association"
          ]
        },
        "direction": { "enum": ["forward", "none"] },
        "fieldPath": { "type": "string", "maxLength": 4096 },
        "branch": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/text" } },
        "evidenceCategory": { "enum": ["schema", "documentation"] },
        "evidenceIds": { "$ref": "#/definitions/ids" },
        "description": { "type": "string", "maxLength": 8192 },
        "required": { "type": "boolean" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "targetConstraint": { "$ref": "#/definitions/text" }
      }
    },
    "useSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaKind", "location", "pointer"],
      "properties": {
        "schemaKind": { "$ref": "#/definitions/text" },
        "location": { "$ref": "#/definitions/text" },
        "pointer": { "type": "string", "pattern": "^(/|$)", "maxLength": 4096 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "namespace",
        "location",
        "revision",
        "contentHash",
        "schemaKind",
        "schemaVersion",
        "pointer",
        "visibility",
        "license",
        "redistribution"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "category": { "enum": ["schema", "documentation"] },
        "namespace": { "$ref": "#/definitions/text" },
        "location": { "$ref": "#/definitions/text" },
        "revision": { "$ref": "#/definitions/text" },
        "contentHash": { "$ref": "#/definitions/hash" },
        "schemaKind": { "$ref": "#/definitions/text" },
        "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "pointer": { "type": "string", "pattern": "^(/|$)", "maxLength": 4096 },
        "dialect": { "$ref": "#/definitions/text" },
        "excerpt": { "type": "string", "maxLength": 8192 },
        "visibility": { "enum": ["public", "private", "unknown"] },
        "license": { "$ref": "#/definitions/text" },
        "redistribution": { "enum": ["reviewed", "unknown", "prohibited"] },
        "attribution": { "type": "string", "maxLength": 8192 },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaKind", "schemaVersion", "location", "pointer", "useSites"],
          "properties": {
            "schemaKind": { "$ref": "#/definitions/text" },
            "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "location": { "$ref": "#/definitions/text" },
            "pointer": { "type": "string", "pattern": "^(/|$)", "maxLength": 4096 },
            "useSites": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "$ref": "#/definitions/useSite" }
            }
          }
        }
      }
    }
  }
}
