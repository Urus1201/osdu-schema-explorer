{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osdu-schema-explorer.local/schemas/graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "revision", "nodes", "edges", "evidence"],
  "properties": {
    "formatVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nodes": { "$ref": "patch.schema.json#/properties/nodes" },
    "edges": { "$ref": "patch.schema.json#/properties/edges" },
    "evidence": { "$ref": "patch.schema.json#/properties/evidence" }
  }
}
